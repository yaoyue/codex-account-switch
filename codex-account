#!/usr/bin/env bash
set -euo pipefail

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
ACCOUNT_ROOT="${CODEX_ACCOUNT_ROOT:-$HOME/.codex-accounts}"
CURRENT_FILE="$ACCOUNT_ROOT/current"

usage() {
  cat <<'USAGE'
用法:
  codex-account status
  codex-account save-current <账号标签>
  codex-account switch <账号标签> [vscode参数...]
  codex-account help

示例:
  codex-account save-current personal
  codex-account switch work .
  codex-account switch team-2 /path/to/project

说明:
  账号数量不限，首次保存新标签即可登记；status 自动列出已保存账号。
  标签以英文字母或数字开头，其余字符可用英文字母、数字、下划线、连字符。
  current 及其大小写变体是内部保留名称，不能作为账号标签。
  只切换 Codex 登录态 auth.json。
  config.toml、历史记录、日志、skills、plugins、VSCode 用户配置仍继续使用同一份。
  日常切换不要在 Codex 内执行退出登录，否则当前账号的 refresh token 可能被服务端撤销。
  切换账号不会自动覆盖已保存登录态，只有 save-current 会显式保存当前登录态。
USAGE
}

die() {
  printf '错误: %s\n' "$*" >&2
  exit 1
}

valid_account() {
  local LC_ALL=C
  case "${1:-}" in
    ''|[cC][uU][rR][rR][eE][nN][tT]|[!a-zA-Z0-9]*|*[!a-zA-Z0-9_-]*) return 1 ;;
  esac
  return 0
}

account_dir() {
  valid_account "${1:-}" || die "账号标签须以英文字母或数字开头，只能包含英文字母、数字、下划线、连字符，且不能使用 current 或其大小写变体"
  printf '%s/%s\n' "$ACCOUNT_ROOT" "$1"
}

auth_path_for() {
  local dir
  dir="$(account_dir "$1")" || return 1
  printf '%s/auth.json\n' "$dir"
}

backup_file() {
  local file="$1"
  [ -f "$file" ] || return 0

  local backup_dir timestamp
  backup_dir="$(dirname "$file")/backups"
  timestamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$backup_dir"
  cp "$file" "$backup_dir/auth.$timestamp.json"
  chmod 600 "$backup_dir/auth.$timestamp.json" 2>/dev/null || true
}

ensure_codex_auth_exists() {
  [ -f "$CODEX_HOME/auth.json" ] || die "未找到 $CODEX_HOME/auth.json，请先在 VSCode/Codex 中登录一次"
}

save_current_as() {
  local account="$1"
  local dir auth
  dir="$(account_dir "$account")"
  auth="$(auth_path_for "$account")"

  ensure_codex_auth_exists
  mkdir -p "$dir"
  chmod 700 "$dir" 2>/dev/null || true
  backup_file "$auth"
  cp "$CODEX_HOME/auth.json" "$auth"
  chmod 600 "$auth" 2>/dev/null || true
  printf '%s\n' "$account" > "$CURRENT_FILE"
  printf '已把当前 Codex 登录态保存为 %s: %s\n' "$account" "$auth"
}

switch_to() {
  local account="$1"
  shift || true

  local target_auth
  target_auth="$(auth_path_for "$account")"
  [ -f "$target_auth" ] || die "未保存 $account 登录态。请先切到该账号并执行: codex-account save-current $account"

  mkdir -p "$CODEX_HOME" "$ACCOUNT_ROOT"
  cp "$target_auth" "$CODEX_HOME/auth.json"
  chmod 600 "$CODEX_HOME/auth.json" 2>/dev/null || true
  printf '%s\n' "$account" > "$CURRENT_FILE"
  printf '已切换 Codex 登录态为 %s。\n' "$account"

  if command -v code >/dev/null 2>&1; then
    if [ "$#" -gt 0 ]; then
      code "$@"
    else
      code .
    fi
  else
    printf '提示: 未找到 code 命令。请在 VSCode 命令面板执行 "Shell Command: Install code command in PATH"。\n' >&2
  fi
}

status() {
  printf 'CODEX_HOME: %s\n' "$CODEX_HOME"
  printf '账号目录: %s\n' "$ACCOUNT_ROOT"
  if [ -f "$CURRENT_FILE" ]; then
    printf '当前标记: %s\n' "$(tr -d '[:space:]' < "$CURRENT_FILE")"
  else
    printf '当前标记: 未设置\n'
  fi

  local auth dir account
  local found=0
  for auth in "$ACCOUNT_ROOT"/*/auth.json; do
    [ -f "$auth" ] || continue
    dir="${auth%/auth.json}"
    account="${dir##*/}"
    valid_account "$account" || continue
    printf '%s: 已保存 (%s)\n' "$account" "$auth"
    found=1
  done
  if [ "$found" -eq 0 ]; then
    printf '尚未保存任何账号。\n'
  fi
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  status) status ;;
  save-current) [ "$#" -eq 1 ] || die "save-current 需要一个账号名"; save_current_as "$1" ;;
  switch) [ "$#" -ge 1 ] || die "switch 需要一个账号名"; account="$1"; shift; switch_to "$account" "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "未知命令: $cmd" ;;
esac
